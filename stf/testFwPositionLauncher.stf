        }
      }
    },
    "c2_cmd": {
      "rc_roll": -0.5,
      "rc_throttle": 0.2,
      "rc_flap": 0
    }
  },
  {
    "comment": "Hold heading",
    "number": 11,
    "tst": {
      "endTime": 55
    },
    "c2_cmd": {
      "rc_roll": 0
    }
  },
  {
